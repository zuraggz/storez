# ---------------------------------------------------------------------------
# Copy to .env for local development:  cp .env.example .env
# On Vercel these are project environment variables instead.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Any Postgres URL. Neon (the Vercel Marketplace integration) sets this for you
# as DATABASE_URL when you connect the store to your project; `postgres://`,
# `postgresql://` and `postgresql+psycopg://` are all accepted.
#
#   DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/qlonil?sslmode=require
#
# Leave it unset locally and the app falls back to a SQLite file (./qlonil.db).
# That fallback is for development only: Vercel's filesystem is read-only and
# ephemeral, so a deployment without DATABASE_URL cannot store anything.
DATABASE_URL=sqlite:///./dev.db

# --- App -------------------------------------------------------------------
# "development" also mounts the OpenAPI docs at /docs and returns exception
# details in error responses. Anything else is treated as production.
ENVIRONMENT=development

# Create the schema and seed demo data on first boot. Both are idempotent, so
# leaving them on is safe; set them to false once you manage the schema yourself.
AUTO_INIT_DB=true
SEED_DEMO_DATA=true

# Origins allowed to call the JSON API from a browser. An entry may use "*" as a
# single-segment wildcard, so https://*.vercel.app admits every preview
# deployment without opening the API to the whole internet. A bare "*" allows any
# origin and should not be used in production. The storefront's own pages are
# same-origin and never need this.
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000

# --- docker compose only ---------------------------------------------------
POSTGRES_DB=qlonil
POSTGRES_USER=qlonil
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
WEB_PORT=8000
